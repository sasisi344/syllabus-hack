---
import PageLayout from '~/layouts/PageLayout.astro';
import { getPermalink, getCanonical } from '~/utils/permalinks';
import type { MetaData } from '~/types';

export interface Props {
  metadata: MetaData;
  examName: string;
  examId: string;
  chapterTitle?: string;
  estimatedMinutes?: number;
  readingTime?: number;
  prevChapter?: { title: string; href: string };
  nextChapter?: { title: string; href: string };
}

const { metadata, examName, examId, chapterTitle, estimatedMinutes, readingTime, prevChapter, nextChapter } = Astro.props;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: String(getCanonical('/')) },
    { '@type': 'ListItem', position: 2, name: '学習コース', item: String(getCanonical(getPermalink('/course'))) },
    {
      '@type': 'ListItem',
      position: 3,
      name: examName,
      item: String(getCanonical(getPermalink(`/course/${examId}`))),
    },
    ...(chapterTitle
      ? [{ '@type': 'ListItem', position: 4, name: chapterTitle, item: String(getCanonical(Astro.url.pathname)) }]
      : []),
  ],
};
---

<PageLayout metadata={metadata}>
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />

  <section class="py-8 sm:py-12 mx-auto max-w-3xl px-4 sm:px-6">
    <nav class="text-sm text-muted dark:text-slate-400 mb-4" aria-label="breadcrumb">
      <a href={getPermalink('/')} class="hover:underline">ホーム</a>
      <span class="mx-1">/</span>
      <a href={getPermalink('/course')} class="hover:underline">学習コース</a>
      <span class="mx-1">/</span>
      <a href={getPermalink(`/course/${examId}`)} class="hover:underline">{examName}</a>
      {
        chapterTitle && (
          <>
            <span class="mx-1">/</span>
            <span>{chapterTitle}</span>
          </>
        )
      }
    </nav>

    {
      (estimatedMinutes || readingTime) && (
        <p class="text-sm text-muted dark:text-slate-400 mb-6">
          {estimatedMinutes && <span>目安時間: 約{estimatedMinutes}分</span>}
          {estimatedMinutes && readingTime && <span> ・ </span>}
          {readingTime && <span>読了目安: {readingTime}分</span>}
        </p>
      )
    }

    <article class="prose prose-md lg:prose-lg dark:prose-invert prose-headings:font-heading prose-a:text-primary dark:prose-a:text-blue-400 max-w-none">
      <slot />
    </article>

    {
      (prevChapter || nextChapter) && (
        <div class="mt-10 flex justify-between gap-4 border-t dark:border-slate-700 pt-6">
          <div>
            {prevChapter && (
              <a href={prevChapter.href} class="text-primary dark:text-blue-400 hover:underline">
                ← {prevChapter.title}
              </a>
            )}
          </div>
          <div class="text-right">
            {nextChapter && (
              <a href={nextChapter.href} class="text-primary dark:text-blue-400 hover:underline">
                {nextChapter.title} →
              </a>
            )}
          </div>
        </div>
      )
    }
  </section>
</PageLayout>
