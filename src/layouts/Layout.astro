---
import '~/assets/styles/tailwind.css';

import { I18N, SITE } from 'astrowind:config';

import { getCanonical } from '~/utils/permalinks';

import CommonMeta from '~/components/common/CommonMeta.astro';
import Favicons from '~/components/Favicons.astro';
import CustomStyles from '~/components/CustomStyles.astro';
import ApplyColorMode from '~/components/common/ApplyColorMode.astro';
import Metadata from '~/components/common/Metadata.astro';
import SiteVerification from '~/components/common/SiteVerification.astro';
import Analytics from '~/components/common/Analytics.astro';
import BasicScripts from '~/components/common/BasicScripts.astro';

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${SITE.site}/#website`,
      url: String(getCanonical('/')),
      name: SITE.name,
      description: 'GenAIで資格試験を攻略する「シラバスハック」。',
      inLanguage: 'ja',
      potentialAction: {
        '@type': 'SearchAction',
        target: {
          '@type': 'EntryPoint',
          urlTemplate: `${SITE.site}/?s={search_term_string}`,
        },
        'query-input': 'required name=search_term_string',
      },
    },
    {
      '@type': 'Organization',
      '@id': `${SITE.site}/#organization`,
      name: SITE.name,
      url: String(getCanonical('/')),
      logo: {
        '@type': 'ImageObject',
        url: `${SITE.site}/favicon.svg`,
      },
      sameAs: ['https://x.com/sasisi344', 'https://www.threads.net/@sasisi344', 'https://github.com/sasisi344'],
    },
  ],
};

// Comment the line below to disable View Transitions
import { ClientRouter } from 'astro:transitions';

import type { MetaData as MetaDataType } from '~/types';

export interface Props {
  metadata?: MetaDataType;
}

const { metadata = {} } = Astro.props;
const { language, textDirection } = I18N;
---

<!doctype html>
<html lang={language} dir={textDirection} class="2xl:text-[20px]">
  <head>
    <CommonMeta />
    <Favicons />
    <CustomStyles />
    <ApplyColorMode />
    <Metadata {...metadata} />
    <SiteVerification />
    {/* GA4: /course/{examId}/ 配下で course_id / content_group を付与。config の page_view より前に set する必要がある */}
    <script is:inline>
      (function () {
        if (window.__courseGaInit) return;
        window.__courseGaInit = true;
        window.dataLayer = window.dataLayer || [];
        function gtag() {
          window.dataLayer.push(arguments);
        }
        function applyCourseParams() {
          var m = location.pathname.match(/^\/course\/([^/]+)/);
          gtag('set', {
            course_id: m ? m[1] : undefined,
            content_group: m ? 'course-' + m[1] : undefined,
          });
        }
        applyCourseParams();
        document.addEventListener('astro:page-load', applyCourseParams);
      })();
    </script>
    <Analytics />
    {/* AdSense 自動広告 */}
    <script
      is:inline
      async
      src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-9798094072282530"
      crossorigin="anonymous"></script>
    <script type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />

    <!-- Comment the line below to disable View Transitions -->
    <ClientRouter fallback="swap" />
  </head>

  <body class="antialiased text-default bg-page tracking-tight">
    <slot />

    <BasicScripts />
  </body>
</html>
