---
import type { InferGetStaticPropsType, GetStaticPaths } from 'astro';
import { blogCategoryRobots, getStaticPathsBlogCategory } from '~/utils/blog';

import Layout from '~/layouts/PageLayout.astro';
import BlogList from '~/components/blog/List.astro';
import Headline from '~/components/blog/Headline.astro';
import Pagination from '~/components/blog/Pagination.astro';

export const prerender = true;

export const getStaticPaths = (async ({ paginate }) => {
  return await getStaticPathsBlogCategory({ paginate });
}) satisfies GetStaticPaths;

type Props = InferGetStaticPropsType<typeof getStaticPaths> & { category: Record<string, string> };

const { page, category } = Astro.props as Props;

const currentPage = page.currentPage ?? 1;

const isAppCategory = category.slug === 'app';
const isGlossaryCategory = category.slug === 'theory';
const appPosts = isAppCategory ? page.data.filter((post) => post.knowledge?.type === 'app') : [];
const storyPosts = isAppCategory ? page.data.filter((post) => post.knowledge?.type !== 'app') : page.data;

// カテゴリ別SEO title / description（2026-07-11 w28-site-verifi T8: 旧 `Category 'X'` 形式を全廃）
const CATEGORY_SEO: Record<string, { title: string; description: string }> = {
  trend: {
    title: 'IT資格の試験情報・シラバス改訂まとめ',
    description:
      'ITパスポート・基本情報・応用情報などIPA試験のCBT移行・シラバス改訂・試験日程の最新情報を解説。生成AI時代の資格トレンドをいち早くキャッチアップできます。',
  },
  method: {
    title: 'AIで資格試験を攻略する学習メソッド一覧',
    description:
      '生成AI（ChatGPT・Gemini・NotebookLM）を活用した資格試験の学習メソッドを紹介。暗記に頼らず最短で合格するためのシラバスハック手法をまとめています。',
  },
  career: {
    title: '資格を活かすキャリア戦略・転職ガイド',
    description:
      'IT資格・ビジネス資格を取得した後のキャリア戦略を解説。転職・年収アップ・独立・資格手当など、資格を実際の市場価値につなげる方法を紹介します。',
  },
  app: {
    title: '資格試験対策の無料クイズ・学習アプリ',
    description:
      'CBTシミュレーター・一問一答クイズなど、資格試験対策の無料ウェブアプリを公開。ブラウザだけで過去問演習・模擬試験・弱点チェックができます。',
  },
  theory: {
    title: 'IT試験用語解説・用語集',
    description:
      'ITパスポート・基本情報などの試験頻出語句を、図解とAI活用法を交えて分かりやすく解説。シラバスに準拠した最新の用語集です。',
  },
};

const seo = CATEGORY_SEO[category.slug] ?? { title: category.title, description: '' };

const metadata = {
  title: `${seo.title}${currentPage > 1 ? ` — Page ${currentPage}` : ''}`,
  description: seo.description,
  robots: {
    index: blogCategoryRobots?.index,
    follow: blogCategoryRobots?.follow,
  },
};
---

<Layout metadata={metadata}>
  <section class="px-4 md:px-6 py-12 sm:py-16 lg:py-20 mx-auto max-w-4xl">
    <Headline>{category.title}</Headline>

    {
      isGlossaryCategory && (
        <div class="mb-10 p-6 bg-blue-50 dark:bg-slate-800 rounded-lg border-l-4 border-primary">
          <p class="text-lg text-muted dark:text-slate-300">
            <strong>シラバス完全準拠：</strong> ITパスポートや基本・応用情報試験に出題される重要用語を網羅。単なる暗記ではなく、<strong>「なぜそれが必要か」</strong>と<strong>AI時代の実践的な活用方法</strong>をセットで解説します。
          </p>
        </div>
      )
    }

    {
      isAppCategory && appPosts.length > 0 && (
        <div class="mb-16">
          <h3 class="text-2xl font-bold mb-8 border-b-2 border-primary pb-2 dark:text-blue-400">
            利用可能なツール・アプリ
          </h3>
          <BlogList posts={appPosts} />
        </div>
      )
    }

    {
      isAppCategory && appPosts.length > 0 && storyPosts.length > 0 && (
        <h3 class="text-2xl font-bold mb-8 border-b-2 border-gray-400 pb-2 dark:text-slate-400">
          開発ストーリー・技術解説
        </h3>
      )
    }

    <BlogList posts={storyPosts} />

    <Pagination prevUrl={page.url.prev} nextUrl={page.url.next} />
  </section>
</Layout>
