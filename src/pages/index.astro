---
import Layout from '~/layouts/PageLayout.astro';
import { getPermalink } from '~/utils/permalinks';

import Hero from '~/components/widgets/Hero.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Headline from '~/components/ui/Headline.astro';
import Button from '~/components/ui/Button.astro';
import WidgetWrapper from '~/components/ui/WidgetWrapper.astro';
import { certGroups } from '~/data/cert-hubs';

const metadata = {
  title: 'Syllabus Hack — 生成AIで資格試験を攻略する',
  ignoreTitleTemplate: true,
};

const methodButtons = [
  {
    text: '20時間ロードマップで学ぶ',
    href: getPermalink('/course'),
    icon: 'tabler:clock-hour-8',
  },
  {
    text: 'AI学習メソッドを読む',
    href: getPermalink('method', 'category'),
    icon: 'tabler:brain',
  },
  {
    text: '問題演習アプリで鍛える',
    href: getPermalink('app', 'category'),
    icon: 'tabler:device-mobile',
  },
  {
    text: '用語辞典で調べる',
    href: getPermalink('theory', 'category'),
    icon: 'tabler:book',
  },
];

const genreIcons: Record<string, string> = {
  ipa: 'tabler:device-desktop-analytics',
  'cloud-network': 'tabler:cloud',
  'ai-data': 'tabler:chart-dots',
  business: 'tabler:briefcase',
  facility: 'tabler:building-factory-2',
};
---

<Layout metadata={metadata}>
  <!-- Hero Widget ******************* -->

  <Hero
    actions={[
      {
        variant: 'primary',
        text: '20時間コースで学ぶ',
        href: getPermalink('/course'),
        icon: 'tabler:clock-hour-8',
      },
      { text: '試験対策アプリを使う', href: getPermalink('app', 'category') },
      { text: '学習メソッドを読む', href: getPermalink('method', 'category') },
    ]}
    image={{ src: '~/assets/images/hero-syllabushack.jpg', alt: 'Syllabus Hack Hero Image' }}
  >
    <Fragment slot="title">
      生成AIで <span class="text-accent dark:text-blue-400">シラバス</span> をハックする
    </Fragment>

    <Fragment slot="subtitle">
      武器は<strong>ChatGPTとClaude</strong>。IT資格に限らず、シラバスのある資格試験なら、ジャンルを問わず攻略ロードマップが作れます。
      ここで学んだ方法は、あなたが次に挑む資格にもそのまま使えます。
    </Fragment>
  </Hero>

  <!-- 学習メソッドの種類（ボタン） ************** -->

  <WidgetWrapper>
    <Headline
      tagline="How to Learn"
      title="学び方は、4つ。目的に合わせて選べます"
      subtitle="どの資格にも使える、ChatGPT・Claudeを活用した汎用の学習メソッドです。"
    />
    <div class="flex flex-wrap justify-center gap-3 max-w-3xl mx-auto">
      {
        methodButtons.map((item) => (
          <Button variant="secondary" href={item.href} icon={item.icon} text={item.text} class="text-sm py-2.5 px-5" />
        ))
      }
    </div>
  </WidgetWrapper>

  <!-- 対応する資格ジャンル（ボタン） ************** -->

  <WidgetWrapper>
    <Headline
      tagline="Coverage"
      title="IT資格だけじゃない。シラバスがあれば、ハックできる。"
      subtitle="簿記、FP、宅建、電験三種、消防設備士——生成AIによる学習ロードマップの作り方は、資格ジャンルを問いません。"
    />
    <div class="flex flex-wrap justify-center gap-3 max-w-4xl mx-auto">
      {
        certGroups.map((group) => (
          <Button
            variant="secondary"
            href={`${getPermalink('/certifications')}#${group.slug}`}
            icon={genreIcons[group.slug]}
            text={group.title}
            class="text-sm py-2.5 px-5"
          />
        ))
      }
      <Button
        variant="primary"
        href={getPermalink('/certifications')}
        text="すべての資格を見る →"
        class="text-sm py-2.5 px-5"
      />
    </div>
  </WidgetWrapper>

  <!-- Content Widget (Polite Explanation) **************** -->

  <Content
    isReversed
    tagline="Concept"
    title="なぜ、今「AIで勉強」なのか"
    items={[
      {
        title: 'パーソナライズされた学習体験',
        description:
          'これまでの「一方通行な学習」から、ChatGPTやClaudeとの「対話的な学習」へ。自分の苦手な部分をAIが察知し、解説を最適化します。',
      },
      {
        title: '資格を問わず使える、シラバス構造化術',
        description:
          '資格試験のシラバスは、どの分野でも肥大化しています。AIを活用して情報を整理・要約する方法は一度覚えれば、次に挑む資格でもそのまま使えます。',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1516321318423-f06f85e504b3?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Concept Image',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">落ち着いた学習環境を提供</h3>
      情報のノイズを削ぎ落とし、勉強に集中できるデザインと機能性を追求しました。
    </Fragment>
  </Content>

  <!-- HighlightedPosts Widget (Blog) ******* -->

  <BlogLatestPosts
    title="最新の学習記事とニュース"
    information={`最新の試験対策メソッドや、シラバス改訂の速報、AI活用のヒントを定期的に更新しています。`}
  />

  <!-- CallToAction Widget *********** -->

  <CallToAction
    actions={[
      {
        variant: 'primary',
        text: '無料の学習メソッドを体験',
        href: '/try',
        icon: 'tabler:rocket',
      },
    ]}
  >
    <Fragment slot="title">
      あなたの合格を <br class="block sm:hidden" /><span class="sm:whitespace-nowrap">AIがバックアップ</span>
    </Fragment>

    <Fragment slot="subtitle">
      PC・スマホ1台で、最新のシラバス攻略を今すぐ始めましょう。 <br
        class="hidden md:inline"
      />生成AIによる効率化と、実践的な演習アプリを無料で体験。
    </Fragment>
  </CallToAction>
</Layout>
