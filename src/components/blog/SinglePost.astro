---
import { Icon } from 'astro-icon/components';

import Image from '~/components/common/Image.astro';
import PostTags from '~/components/blog/Tags.astro';
import TableOfContents from '~/components/blog/TableOfContents.astro';
import SocialShare from '~/components/common/SocialShare.astro';
import MermaidStyles from '~/components/common/MermaidStyles.astro';
import RegionWidget from '~/apps/region-suggest/RegionWidget';
import sasisiImg from '~/assets/images/sasisi344.jpg';
import { authorStanceFor } from '~/data/author-exam-status';

import { SITE } from 'astrowind:config';
import { getCanonical, getPermalink } from '~/utils/permalinks';
import { getFormattedDate } from '~/utils/utils';

import type { Post } from '~/types';

export interface Props {
  post: Post;
  url: string | URL;
}

const { post, url } = Astro.props;

const postUrl = String(url);
const isHubPage = post.slug?.endsWith('-hub');
const authorStance = authorStanceFor(post.knowledge?.examId);
const imageUrl =
  post.image && typeof post.image === 'object' && 'src' in post.image
    ? `${SITE.site}${post.image.src}`
    : typeof post.image === 'string'
      ? post.image
      : undefined;

const blogPostingJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  '@id': postUrl,
  url: postUrl,
  headline: post.title,
  description: post.excerpt,
  datePublished: post.publishDate.toISOString(),
  dateModified: (post.updateDate ?? post.publishDate).toISOString(),
  author: {
    '@type': 'Person',
    name: post.author ?? 'さしし',
    url: String(getCanonical(getPermalink('about'))),
  },
  publisher: {
    '@type': 'Organization',
    '@id': `${SITE.site}/#organization`,
    name: SITE.name,
    logo: {
      '@type': 'ImageObject',
      url: `${SITE.site}/favicon.svg`,
    },
  },
  ...(imageUrl ? { image: { '@type': 'ImageObject', url: imageUrl } } : {}),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': postUrl,
  },
};

const faqPageJsonLd =
  post.faqs && post.faqs.length > 0
    ? {
        '@context': 'https://schema.org',
        '@type': 'FAQPage',
        mainEntity: post.faqs.map((faq) => ({
          '@type': 'Question',
          name: faq.question,
          acceptedAnswer: {
            '@type': 'Answer',
            text: faq.answer,
          },
        })),
      }
    : null;

const breadcrumbJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: String(getCanonical('/')) },
    ...(post.category
      ? [
          {
            '@type': 'ListItem',
            position: 2,
            name: post.category.title,
            item: `${SITE.site}${getPermalink(post.category.slug, 'category')}`,
          },
          { '@type': 'ListItem', position: 3, name: post.title, item: postUrl },
        ]
      : [{ '@type': 'ListItem', position: 2, name: post.title, item: postUrl }]),
  ],
};
---

<script type="application/ld+json" set:html={JSON.stringify(blogPostingJsonLd)} />
<script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />
{faqPageJsonLd && <script type="application/ld+json" set:html={JSON.stringify(faqPageJsonLd)} />}

<section class="post-shell mx-auto">
  <article>
    <nav class="post-breadcrumb" aria-label="パンくずリスト">
      <a href={getPermalink('/')}>ホーム</a><span aria-hidden="true">/</span>
      {
        post.category && (
          <>
            <>
              <a href={getPermalink(post.category.slug, 'category')}>{post.category.title}</a>
              <span aria-hidden="true">/</span>
            </>
          </>
        )
      }
      <span>記事</span>
    </nav>
    <header class="post-header">
      <div
        class="post-meta flex justify-between flex-col sm:flex-row max-w-3xl mx-auto mt-0 mb-2 px-4 sm:px-6 sm:items-center"
      >
        <p>
          <Icon name="tabler:clock" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
          <time datetime={String(post.publishDate)} class="inline-block">{getFormattedDate(post.publishDate)}</time>
          {
            post.author && (
              <>
                {' '}
                · <Icon name="tabler:user" class="w-4 h-4 inline-block -mt-0.5 dark:text-gray-400" />
                <span class="inline-block">{post.author}</span>
              </>
            )
          }
          {
            post.category && (
              <>
                {' '}
                ·{' '}
                <a class="hover:underline inline-block" href={getPermalink(post.category.slug, 'category')}>
                  {post.category.title}
                </a>
              </>
            )
          }
          {
            post.readingTime && (
              <>
                &nbsp;· <span>{post.readingTime}</span> min read
              </>
            )
          }
        </p>
      </div>

      <h1
        class="post-title px-4 sm:px-6 max-w-3xl mx-auto text-4xl md:text-5xl font-bold leading-tighter tracking-tighter font-heading"
      >
        {post.title}
      </h1>
      <p
        class="post-summary max-w-3xl mx-auto mt-4 mb-8 px-4 sm:px-6 text-xl md:text-2xl text-muted dark:text-slate-400 text-justify"
      >
        {post.excerpt}
      </p>

      {
        post.image ? (
          <div class="post-cover-frame">
            <Image
              src={post.image}
              class="post-cover max-w-full lg:max-w-[900px] mx-auto mb-6 sm:rounded-md bg-gray-400 dark:bg-slate-700"
              widths={[400, 900]}
              sizes="(max-width: 900px) 400px, 900px"
              alt={post?.excerpt || ''}
              width={900}
              height={506}
              loading="eager"
              fetchpriority="high"
              decoding="async"
            />
          </div>
        ) : (
          <div class="max-w-3xl mx-auto px-4 sm:px-6">
            <div class="border-t dark:border-slate-700" />
          </div>
        )
      }
    </header>
    {post.toc && post.headings && <TableOfContents headings={post.headings} />}
    <div
      class="post-body mx-auto px-6 sm:px-6 max-w-3xl prose prose-md lg:prose-xl dark:prose-invert dark:prose-headings:text-slate-300 prose-headings:font-heading prose-headings:leading-tighter prose-headings:tracking-tighter prose-headings:font-bold prose-a:text-primary dark:prose-a:text-blue-400 prose-img:rounded-md prose-img:shadow-lg mt-8 prose-headings:scroll-mt-[80px] prose-li:my-0"
    >
      <slot />
    </div>

    {post.hasMermaid && <MermaidStyles />}
    <script>
      // Render the placeholders produced by mermaidFenceRemarkPlugin; mermaid is only fetched on pages that have them
      const figures = document.querySelectorAll<HTMLElement>('figure.mermaid-diagram');
      if (figures.length > 0) {
        const render = async () => {
          const mermaid = (await import('mermaid')).default;
          mermaid.initialize({
            startOnLoad: false,
            theme: document.documentElement.classList.contains('dark') ? 'dark' : 'default',
            securityLevel: 'strict',
            fontFamily: 'inherit',
          });
          for (const [i, fig] of figures.entries()) {
            const src = fig.querySelector('pre.mermaid-src')?.textContent ?? '';
            const canvas = fig.querySelector('.mermaid-diagram-canvas');
            if (!canvas) continue;
            try {
              const { svg } = await mermaid.render(`post-mermaid-${i}-${Date.now()}`, src);
              canvas.innerHTML = svg;
            } catch {
              canvas.innerHTML = '<p class="mermaid-diagram-error">図の描画に失敗しました。</p>';
            }
          }
        };
        render();
        // Re-render when dark mode toggles (html.dark)
        new MutationObserver(render).observe(document.documentElement, {
          attributes: true,
          attributeFilter: ['class'],
        });
      }
    </script>
    {
      isHubPage && (
        <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-10">
          <RegionWidget client:idle />
        </div>
      )
    }

    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-8 flex justify-between flex-col sm:flex-row">
      <PostTags tags={post.tags} class="mr-5 rtl:mr-0 rtl:ml-5" />
      <SocialShare url={url} text={post.title} class="mt-5 sm:mt-1 align-middle text-gray-500 dark:text-slate-600" />
    </div>

    <div class="mx-auto px-6 sm:px-6 max-w-3xl mt-10">
      <a
        href={getPermalink('about')}
        class="post-author flex flex-col sm:flex-row gap-4 items-center bg-slate-50 dark:bg-slate-800/40 border border-gray-200 dark:border-gray-700 rounded-2xl p-5 hover:border-primary dark:hover:border-blue-400 transition"
      >
        <img
          src={sasisiImg.src}
          alt="sasisi344"
          class="w-16 h-16 flex-shrink-0 object-cover rounded-full border-2 border-gray-100 dark:border-slate-800"
          loading="lazy"
          decoding="async"
        />
        <div class="text-center sm:text-left">
          <p class="text-sm text-secondary dark:text-blue-200 font-bold tracking-wide uppercase">執筆者</p>
          <p class="font-bold text-heading dark:text-white">さしし / @sasisi344</p>
          <p class="text-sm text-muted mt-1">
            自分のサイト運営・ネットワーク構築・Web開発をひととおり自分でこなす40代後半。生成AIを使った「対話型」学習メソッドを自ら実践・検証しながらSyllabus
            Hackで発信しています。
          </p>
          {authorStance && <p class="text-sm text-muted mt-2">この記事の資格について: {authorStance}</p>}
        </div>
      </a>
    </div>
  </article>
</section>
