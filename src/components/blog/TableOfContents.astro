---
import { Icon } from 'astro-icon/components';

export interface Props {
  headings: { depth: number; slug: string; text: string }[];
  minHeadings?: number;
}

const { headings = [], minHeadings = 2 } = Astro.props;

// h2 を主要項目、h3 をぶら下がりとして表示（h4 以下は省略）
const items = headings.filter((h) => h.depth === 2 || h.depth === 3);
const show = items.filter((h) => h.depth === 2).length >= minHeadings;
---

{
  show && (
    <nav
      aria-label="目次"
      class="mx-auto max-w-3xl px-6 sm:px-6 mt-8 mb-2"
    >
      <details
        open
        class="bg-slate-50 dark:bg-slate-800/40 border border-gray-200 dark:border-gray-700 rounded-2xl px-5 py-4"
      >
        <summary class="cursor-pointer select-none font-bold text-heading dark:text-white flex items-center gap-2">
          <Icon name="tabler:list" class="w-5 h-5 inline-block text-primary dark:text-blue-400" />
          目次
        </summary>
        <ol class="mt-3 space-y-1.5 text-sm md:text-base">
          {items.map((h) => (
            <li class={h.depth === 3 ? 'ml-5' : ''}>
              <a
                href={`#${h.slug}`}
                class="text-muted dark:text-slate-400 hover:text-primary dark:hover:text-blue-400 hover:underline"
              >
                {h.text}
              </a>
            </li>
          ))}
        </ol>
      </details>
    </nav>
  )
}
