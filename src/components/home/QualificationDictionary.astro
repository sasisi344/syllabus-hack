---
import { Icon } from 'astro-icon/components';
import { certGroups } from '~/data/cert-hubs';
import { getPermalink } from '~/utils/permalinks';

const groups = ['ipa', 'ai-data', 'business', 'cloud-network', 'facility'].map(
  (slug) => certGroups.find((group) => group.slug === slug)!
);
const selections = groups.flatMap((group) =>
  group.items.map((item) => ({ ...item, label: group.label, icon: group.icon, color: group.color, group: group.slug }))
);
---

<qualification-dictionary aria-label="資格の辞書" aria-roledescription="カルーセル" role="region" tabindex="0">
  <div class="dictionary-tabs" aria-label="資格のジャンル">
    {
      groups.map((entry, index) => (
        <button
          type="button"
          data-group-select={entry.slug}
          aria-pressed={index === 0}
          style={`--tab-color:${entry.color}`}
        >
          {entry.label}
        </button>
      ))
    }
  </div>
  <div class="dictionary-stage">
    <button class="neighbor neighbor-prev" type="button" data-direction="-1" aria-label="前の資格をめくる">
      <Icon name="tabler:book-2" /><span data-neighbor-prev>{groups[0].items.at(-1)?.name}</span>
    </button>
    <div class="dictionary-book">
      {
        selections.map((entry, index) => (
          <article
            class="dictionary-spread"
            data-slide
            data-name={entry.name}
            data-group={entry.group}
            data-label={entry.label}
            hidden={index !== 0}
            aria-label={`${index + 1} / ${selections.length} ${entry.name}`}
            aria-roledescription="スライド"
            style={`--cover:${entry.color}`}
          >
            <div class="dictionary-cover">
              <span class="volume">
                SYLLABUS HACK <span>{String(index + 1).padStart(2, '0')}</span>
              </span>
              <Icon name={entry.icon} class="qualification-icon" />
              <>
                <h2>{entry.name}</h2>
                <span class="cover-rule" />
              </>
              <>
                <span class="cover-caption">学びの入口を、この一冊から。</span>
                <span class="paper-curl" aria-hidden="true" />
              </>
            </div>
            <div class="dictionary-page">
              <>
                <span class="page-kicker">{entry.label} / 資格ガイド</span>
                <h3>{entry.name}</h3>
              </>
              <nav aria-label={`${entry.name}の学習リンク`}>
                <a href={entry.href}>
                  <>
                    <Icon name="tabler:book" />
                    <span>シラバス・試験ガイド</span>
                    <Icon name="tabler:chevron-right" />
                  </>
                </a>
                {entry.courseHref && (
                  <a href={getPermalink(entry.courseHref)}>
                    <Icon name="tabler:route" />
                    <span>コースで学ぶ</span>
                    <Icon name="tabler:chevron-right" />
                  </a>
                )}
                <a href={getPermalink('method', 'category')}>
                  <>
                    <Icon name="tabler:stack-2" />
                    <span>AI学習メソッド</span>
                    <Icon name="tabler:chevron-right" />
                  </>
                </a>
                <a href={getPermalink('app', 'category')}>
                  <>
                    <Icon name="tabler:pencil" />
                    <span>問題演習を探す</span>
                    <Icon name="tabler:chevron-right" />
                  </>
                </a>
              </nav>
              <a class="dictionary-cta" href={entry.href}>
                この資格を開く <Icon name="tabler:arrow-up-right" />
              </a>
              <span class="page-number" aria-hidden="true">
                — {String(index + 1).padStart(2, '0')} —
              </span>
            </div>
          </article>
        ))
      }
      <div class="flip-layer" aria-hidden="true"></div>
    </div>
    <button class="neighbor neighbor-next" type="button" data-direction="1" aria-label="次の資格をめくる">
      <Icon name="tabler:book-2" /><span data-neighbor-next>{selections[1].name}</span>
    </button>
  </div>
  <div class="dictionary-controls">
    <button class="turn-arrow" type="button" data-direction="-1" aria-label="前の資格"
      ><Icon name="tabler:chevron-left" /></button
    >
    <div class="dictionary-progress">
      <p class="gesture-hint">
        <span class="desktop-hint">ドラッグして、めくって探す</span><span class="mobile-hint"
          >左右にスワイプして探す</span
        >
      </p>
      <div class="dictionary-dots" aria-label="表示する資格">
        {
          selections.map((entry, index) => (
            <button
              type="button"
              data-select={index}
              data-group={entry.group}
              hidden={entry.group !== groups[0].slug}
              aria-label={entry.name}
              aria-pressed={index === 0}
            >
              <span />
            </button>
          ))
        }
      </div>
    </div>
    <button class="turn-arrow" type="button" data-direction="1" aria-label="次の資格"
      ><Icon name="tabler:chevron-right" /></button
    >
  </div>
  <div class="dictionary-picker">
    <div class="dictionary-picker-select">
      <label for="dictionary-exam">資格を選ぶ</label>
      <select id="dictionary-exam" aria-label="選んだジャンルの資格">
        {
          selections.map((entry, index) => (
            <option
              value={index}
              data-group={entry.group}
              hidden={entry.group !== groups[0].slug}
              disabled={entry.group !== groups[0].slug}
            >
              {entry.name}
            </option>
          ))
        }
      </select>
    </div>
    <a class="dictionary-more" href={`${getPermalink('/certifications')}#${groups[0].slug}`} data-group-more
      >{groups[0].label}の他のも見る <Icon name="tabler:arrow-up-right" /></a
    >
  </div>
  <p class="dictionary-status sr-only" aria-live="polite" aria-atomic="true">
    IT（IPA） 1 / {groups[0].items.length}：{selections[0].name}
  </p>
</qualification-dictionary>

<script>
  class QualificationDictionary extends HTMLElement {
    private controller?: AbortController;
    private timer?: ReturnType<typeof setTimeout>;
    connectedCallback() {
      this.controller?.abort();
      this.controller = new AbortController();
      const { signal } = this.controller;
      const slides = Array.from(this.querySelectorAll<HTMLElement>('[data-slide]'));
      const layer = this.querySelector<HTMLElement>('.flip-layer')!;
      const status = this.querySelector<HTMLElement>('.dictionary-status')!;
      const select = this.querySelector<HTMLSelectElement>('select')!;
      const more = this.querySelector<HTMLAnchorElement>('[data-group-more]')!;
      let active = Math.max(
        0,
        slides.findIndex((slide) => !slide.hidden)
      );
      let group = slides[active].dataset.group!;
      let start: { x: number; y: number; id: number } | undefined;
      const indices = () => slides.flatMap((slide, index) => (slide.dataset.group === group ? [index] : []));
      const update = () => {
        const members = indices();
        const position = members.indexOf(active);
        const label = slides[active].dataset.label!;
        this.querySelectorAll<HTMLButtonElement>('[data-group-select]').forEach((button) => {
          button.setAttribute('aria-pressed', String(button.dataset.groupSelect === group));
        });
        this.querySelectorAll<HTMLButtonElement>('[data-select]').forEach((button) => {
          button.hidden = button.dataset.group !== group;
          button.setAttribute('aria-pressed', String(Number(button.dataset.select) === active));
        });
        Array.from(select.options).forEach((option) => {
          option.hidden = option.dataset.group !== group;
          option.disabled = option.hidden;
        });
        select.value = String(active);
        more.href = `${more.pathname}#${group}`;
        more.replaceChildren(document.createTextNode(`${label}の他のも見る ↗`));
        this.querySelector('[data-neighbor-prev]')!.textContent =
          slides[members[(position + members.length - 1) % members.length]].dataset.name!;
        this.querySelector('[data-neighbor-next]')!.textContent =
          slides[members[(position + 1) % members.length]].dataset.name!;
        status.textContent = `${label} ${position + 1} / ${members.length}：${slides[active].dataset.name}`;
        const dots = this.querySelector<HTMLElement>('.dictionary-dots')!;
        const dot = dots.querySelector<HTMLButtonElement>(`[data-select="${active}"]`);
        if (dot)
          dots.scrollLeft +=
            dot.getBoundingClientRect().left -
            dots.getBoundingClientRect().left -
            dots.clientWidth / 2 +
            dot.offsetWidth / 2;
      };
      const show = (next: number, backwards = next < active) => {
        if (!slides[next] || next === active) return;
        clearTimeout(this.timer);
        layer.classList.remove('is-turning');
        layer.replaceChildren();
        const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        if (!reduceMotion) {
          const sheet = document.createElement('div');
          sheet.className = 'turning-sheet';
          sheet.textContent = slides[active].dataset.name || '';
          layer.append(sheet);
          layer.classList.toggle('backwards', backwards);
          void layer.offsetWidth;
          layer.classList.add('is-turning');
          this.timer = setTimeout(() => {
            layer.classList.remove('is-turning');
            layer.replaceChildren();
          }, 620);
        }
        slides[active].hidden = true;
        slides[next].hidden = false;
        active = next;
        group = slides[active].dataset.group!;
        update();
      };
      const turn = (direction: number) => {
        const members = indices();
        const position = members.indexOf(active);
        show(members[(position + direction + members.length) % members.length], direction < 0);
      };
      update();
      this.addEventListener(
        'click',
        (event) => {
          const button = (event.target as Element).closest<HTMLButtonElement>('button');
          if (!button) return;
          if (button.dataset.groupSelect)
            show(slides.findIndex((slide) => slide.dataset.group === button.dataset.groupSelect));
          else if (button.dataset.select !== undefined) show(Number(button.dataset.select));
          else if (button.dataset.direction) turn(Number(button.dataset.direction));
        },
        { signal }
      );
      select.addEventListener('change', () => show(Number(select.value)), { signal });
      this.addEventListener(
        'keydown',
        (event) => {
          if (
            (event.target as Element).closest('select') ||
            event.altKey ||
            event.ctrlKey ||
            event.metaKey ||
            !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)
          )
            return;
          event.preventDefault();
          const members = indices();
          if (event.key === 'Home' || event.key === 'End')
            show(event.key === 'Home' ? members[0] : members[members.length - 1]);
          else turn(event.key === 'ArrowLeft' ? -1 : 1);
        },
        { signal }
      );
      const stage = this.querySelector<HTMLElement>('.dictionary-stage')!;
      let suppressClick = false;
      let dragging = false;
      // Capture only after horizontal intent is clear, so taps keep their original link target.
      stage.addEventListener(
        'pointerdown',
        (event) => {
          suppressClick = false;
          if (!event.isPrimary || event.button !== 0) return;
          start = { x: event.clientX, y: event.clientY, id: event.pointerId };
          dragging = false;
        },
        { signal }
      );
      stage.addEventListener(
        'pointermove',
        (event) => {
          if (!start || start.id !== event.pointerId) return;
          const dx = event.clientX - start.x,
            dy = event.clientY - start.y;
          if (!dragging && Math.abs(dy) > 12 && Math.abs(dy) > Math.abs(dx)) {
            start = undefined;
            return;
          }
          if (!dragging && Math.abs(dx) > 12 && Math.abs(dx) > Math.abs(dy) * 1.3) {
            dragging = true;
            stage.setPointerCapture(event.pointerId);
          }
          if (dragging && event.cancelable) event.preventDefault();
        },
        { signal }
      );
      stage.addEventListener(
        'pointerup',
        (event) => {
          if (!start || start.id !== event.pointerId) return;
          const dx = event.clientX - start.x,
            dy = event.clientY - start.y;
          const swiped = Math.abs(dx) > 40 && Math.abs(dx) > Math.abs(dy) * 1.3;
          suppressClick = dragging || swiped;
          start = undefined;
          dragging = false;
          if (swiped) turn(dx < 0 ? 1 : -1);
        },
        { signal }
      );
      stage.addEventListener(
        'click',
        (event) => {
          if (!suppressClick) return;
          suppressClick = false;
          event.preventDefault();
          event.stopImmediatePropagation();
        },
        { signal, capture: true }
      );
      stage.addEventListener('dragstart', (event) => event.preventDefault(), { signal });
      stage.addEventListener(
        'pointercancel',
        () => {
          start = undefined;
          dragging = false;
          suppressClick = false;
        },
        { signal }
      );
      stage.addEventListener(
        'lostpointercapture',
        (event) => {
          if (event.target !== stage) return;
          start = undefined;
          dragging = false;
        },
        { signal }
      );
    }
    disconnectedCallback() {
      this.controller?.abort();
      clearTimeout(this.timer);
      this.querySelector('.flip-layer')?.classList.remove('is-turning');
    }
  }
  if (!customElements.get('qualification-dictionary'))
    customElements.define('qualification-dictionary', QualificationDictionary);
</script>

<style>
  qualification-dictionary {
    display: block;
    max-width: 1120px;
    margin: 0 auto;
    outline-offset: 8px;
  }
  .dictionary-tabs {
    display: flex;
    justify-content: center;
    gap: 6px;
    padding: 0 14%;
  }
  .dictionary-tabs button {
    min-height: 42px;
    padding: 9px 18px 14px;
    border-radius: 16px 16px 0 0;
    background: var(--tab-color);
    color: white;
    font-size: 12px;
    letter-spacing: 0.05em;
    transform: translateY(7px);
    transition: transform 0.2s;
  }
  .dictionary-tabs button[aria-pressed='true'] {
    transform: translateY(0);
    background: #28723e;
  }
  .dictionary-stage {
    position: relative;
    padding: 0 13%;
    touch-action: pan-y pinch-zoom;
    user-select: none;
    cursor: grab;
  }
  .dictionary-stage:active {
    cursor: grabbing;
  }
  .dictionary-book {
    position: relative;
    z-index: 2;
    padding: 6px 7px 12px;
    border-radius: 12px 18px 16px 12px;
    background: #24394a;
    box-shadow:
      0 20px 30px -20px #102c3b99,
      0 3px 5px #102c3b33;
  }
  .dictionary-book::after {
    content: '';
    position: absolute;
    inset: auto 10px 5px;
    height: 7px;
    border-radius: 0 0 5px 5px;
    background: repeating-linear-gradient(#d0c5b1 0 1px, #eee7da 1px 3px);
  }
  .dictionary-spread {
    position: relative;
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: 405px;
  }
  .dictionary-spread[hidden] {
    display: none;
  }
  .dictionary-cover {
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 32px 25px 40px;
    background: radial-gradient(ellipse at 0 0, #ffffff09, transparent 70%), var(--cover);
    color: #fff;
    border: 1px solid #ffffff30;
    border-radius: 6px 40% 3px 6px / 6px 9px 3px 6px;
    box-shadow: inset -15px 0 18px -15px #000b;
  }
  .volume {
    align-self: stretch;
    display: flex;
    justify-content: space-between;
    margin-bottom: 24px;
    font: 10px/1.5 sans-serif;
    letter-spacing: 0.15em;
    color: #ffffffaa;
  }
  .volume span {
    color: white;
    font:
      20px/1 Georgia,
      serif;
  }
  .qualification-icon {
    width: 76px;
    height: 76px;
    stroke-width: 1;
    margin-bottom: 22px;
  }
  .dictionary-cover h2 {
    font-family: var(--home-serif);
    font-size: clamp(19px, 2vw, 28px);
    overflow-wrap: anywhere;
    line-height: 1.5;
    text-align: center;
    font-weight: 600;
  }
  .cover-rule {
    width: 46px;
    height: 1px;
    background: #ffffff80;
    margin: 22px 0;
  }
  .cover-caption {
    font-size: 10px;
    letter-spacing: 0.07em;
    color: #ffffffb0;
  }
  .paper-curl {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 48px;
    height: 48px;
    border-radius: 100% 0 0;
    background: linear-gradient(135deg, #b6ad9c, #fffaf0 50%, #e0d5bf 72%, #24394a 73%);
    filter: drop-shadow(-3px -3px 4px #0002);
  }
  .dictionary-page {
    display: flex;
    flex-direction: column;
    position: relative;
    padding: 30px 30px 20px;
    border-radius: 40% 6px 6px 2px / 9px 6px 6px 2px;
    background: linear-gradient(90deg, #ddd5c5, #faf7ef 9%, #fffdf7 75%, #eee7d8);
    color: #172c3c;
    box-shadow: inset 10px 0 16px -14px #0009;
  }
  .page-kicker {
    font-size: 9px;
    letter-spacing: 0.12em;
    color: #72746e;
  }
  .dictionary-page h3 {
    font-family: var(--home-serif);
    font-weight: 600;
    font-size: clamp(17px, 1.8vw, 25px);
    overflow-wrap: anywhere;
    line-height: 1.5;
    padding: 13px 0 17px;
    border-bottom: 1px solid #bdbbad;
  }
  .dictionary-page nav {
    margin: 10px 0 18px;
  }
  .dictionary-page nav a {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 0;
    font-size: 12px;
    border-bottom: 1px solid #ddd8ca;
  }
  .dictionary-page nav a:hover {
    color: #28723e;
  }
  .dictionary-page nav svg {
    width: 19px;
    height: 19px;
    flex-shrink: 0;
    stroke-width: 1.5;
  }
  .dictionary-page nav svg:last-child {
    margin-left: auto;
    width: 13px;
  }
  .dictionary-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    background: #28723e;
    color: white;
    padding: 14px 15px;
    margin-top: auto;
    border-radius: 3px;
    font-size: 13px;
    font-weight: 600;
    box-shadow: 0 3px 5px #133c1920;
  }
  .dictionary-cta:hover {
    background: #1c5930;
  }
  .dictionary-cta svg {
    width: 18px;
    height: 18px;
  }
  .page-number {
    display: block;
    text-align: center;
    color: #858173;
    font:
      10px Georgia,
      serif;
    margin-top: 16px;
  }
  .neighbor {
    position: absolute;
    top: 12%;
    bottom: 7%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 20px;
    width: 18%;
    padding: 20px;
    background: linear-gradient(90deg, #e6dece, #fffdf7 15%, #f1ebdf);
    color: #24394a;
    border: 5px solid #768d92;
    border-bottom-width: 9px;
    border-radius: 8px;
    box-shadow: 0 5px 8px #0002;
    font-family: var(--home-serif);
    font-size: 19px;
  }
  .neighbor-prev {
    left: 3%;
    transform: rotate(-7deg);
  }
  .neighbor-next {
    right: 3%;
    transform: rotate(7deg);
    border-color: #b4a16f;
  }
  .neighbor span {
    writing-mode: vertical-rl;
    max-height: 190px;
  }
  .neighbor svg {
    width: 28px;
    height: 28px;
  }
  .neighbor:hover {
    filter: brightness(0.97);
  }
  .dictionary-controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 24px;
    padding: 25px 0 0;
  }
  .turn-arrow {
    width: 44px;
    height: 44px;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--home-paper);
    border: 1px solid var(--home-line);
    box-shadow: 0 3px 5px #0000000a;
  }
  .turn-arrow:hover {
    color: var(--home-green);
    border-color: var(--home-green);
  }
  .turn-arrow svg {
    width: 20px;
    height: 20px;
  }
  .dictionary-progress {
    min-width: 210px;
    text-align: center;
  }
  .gesture-hint {
    font-size: 11px;
    letter-spacing: 0.1em;
    color: var(--home-muted);
  }
  .mobile-hint {
    display: none;
  }
  .dictionary-dots {
    display: flex;
    max-width: 180px;
    overflow-x: auto;
    margin: auto;
    scrollbar-width: thin;
  }
  .dictionary-dots button {
    flex-shrink: 0;
  }
  .dictionary-dots button[hidden] {
    display: none;
  }
  .dictionary-picker {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-wrap: wrap;
    gap: 14px 24px;
    margin: 20px auto 0;
    padding: 0 14%;
  }
  .dictionary-picker-select {
    display: flex;
    align-items: center;
    gap: 12px;
    max-width: 100%;
    min-width: 0;
  }
  .dictionary-picker label {
    font-size: 11px;
    color: var(--home-muted);
    flex-shrink: 0;
  }
  .dictionary-picker select {
    min-width: 0;
    width: 270px;
    max-width: 100%;
    padding: 11px 30px 11px 12px;
    border: 1px solid var(--home-line);
    border-radius: 3px;
    background: var(--home-paper);
    color: var(--home-ink);
    font-size: 12px;
  }
  .dictionary-more {
    color: var(--home-green);
    font-size: 12px;
    display: flex;
    gap: 8px;
    align-items: center;
  }
  .dictionary-more svg {
    width: 15px;
    height: 15px;
  }
  @media (max-width: 700px) {
    .dictionary-picker {
      padding: 0 3%;
      margin-top: 16px;
    }
    .dictionary-picker-select {
      width: 100%;
    }
    .dictionary-picker select {
      flex: 1;
      width: 0;
      font-size: 12px;
    }
  }
  .dictionary-dots button {
    width: 30px;
    height: 30px;
    display: grid;
    place-items: center;
  }
  .dictionary-dots span {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #b8b9b1;
    transition: transform 0.2s;
  }
  .dictionary-dots button[aria-pressed='true'] span {
    background: var(--home-green);
    transform: scale(1.4);
  }
  .flip-layer {
    position: absolute;
    z-index: 5;
    top: 6px;
    bottom: 12px;
    left: 50%;
    right: 7px;
    perspective: 1400px;
    pointer-events: none;
  }
  .flip-layer.backwards {
    left: 7px;
    right: 50%;
  }
  .flip-layer :global(.turning-sheet) {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    font: 600 22px var(--home-serif);
    color: #24394a;
    background: linear-gradient(90deg, #d9d0be, #fffdf7 13%, #f5efe2);
    transform-origin: left center;
    border-radius: 3px 8px 8px 3px;
    backface-visibility: hidden;
