---
import '~/assets/styles/inter-latin.css';

// 'DM Sans'
// Nunito
// Dosis
// Outfit
// Roboto
// Literata
// 'IBM Plex Sans'
// Karla
// Poppins
// 'Fira Sans'
// 'Libre Franklin'
// Inconsolata
// Raleway
// Oswald
// 'Space Grotesk'
// Urbanist
---

<style is:inline>
  :root {
    --aw-font-sans: 'Inter Variable';
    --sh-font-editorial: 'Yu Mincho', 'Hiragino Mincho ProN', 'Noto Serif JP', Georgia, serif;
    --aw-font-serif: var(--sh-font-editorial);
    --aw-font-heading: var(--sh-font-editorial);

    --aw-color-primary: #28723e;
    --aw-color-secondary: #1c5930;
    --aw-color-accent: #28723e;

    --aw-color-text-heading: #192c3c;
    --aw-color-text-default: #243744;
    --aw-color-text-muted: #68736f;
    --aw-color-bg-page: #fcfbf7;

    --aw-color-bg-page-dark: #18232a;

    --sh-paper: #f5f2e9;
    --sh-line: #dadbd2;

    ::selection {
      background-color: #cbe6ce;
    }
  }

  .dark {
    --aw-font-sans: 'Inter Variable';
    --sh-font-editorial: 'Yu Mincho', 'Hiragino Mincho ProN', 'Noto Serif JP', Georgia, serif;
    --aw-font-serif: var(--sh-font-editorial);
    --aw-font-heading: var(--sh-font-editorial);

    --aw-color-primary: #84ce99;
    --aw-color-secondary: #a2deb1;
    --aw-color-accent: #84ce99;

    --aw-color-text-heading: #f1eee6;
    --aw-color-text-default: #e3e7e2;
    --aw-color-text-muted: #b0b7b4;
    --aw-color-bg-page: #18232a;

    --sh-paper: #213036;
    --sh-line: #3e4a4d;

    ::selection {
      background-color: black;
      color: snow;
    }
  }
</style>
